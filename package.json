{
  "name": "@homebridge-plugins/homebridge-updater",
  "displayName": "Homebridge Updater",
  "type": "module",
  "version": "3.1.7",
  "description": "A Homebridge plugin for checking for updates to Homebridge and plugins",
  "author": "David Maher",
  "license": "BSD-2-Clause",
  "funding": [
    {
      "type": "kofi",
      "url": "https://ko-fi.com/sunookitsune"
    },
    {
      "type": "paypal",
      "url": "https://paypal.me/sunoo"
    },
    {
      "type": "github",
      "url": "https://github.com/Sunoo"
    },
    {
      "type": "liberapay",
      "url": "https://liberapay.com/Sunoo"
    }
  ],
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/homebridge-plugins/homebridge-updater#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/homebridge-plugins/homebridge-updater.git"
  },
  "bugs": {
    "url": "https://github.com/homebridge-plugins/homebridge-updater/issues"
  },
  "keywords": [
    "homebridge-plugin",
    "supports-matter",
    "plugin",
    "update",
    "updates",
    "upgrade",
    "upgrades",
    "version",
    "versions"
  ],
  "main": "dist/index.js",
  "files": [
    "LICENSE",
    "README.md",
    "config.schema.json",
    "dist/**/*",
    "package.json"
  ],
  "engines": {
    "homebridge": "^1.11.4 || ^2.0.0",
    "node": "^22 || ^24"
  },
  "scripts": {
    "check": "npm install && npm outdated",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "watch": "npm run build && npm run plugin-ui && npm link && nodemon",
    "plugin-ui": "rsync ./src/homebridge-ui/public/index.html ./dist/homebridge-ui/public/",
    "build": "npm run clean && tsc && npm run plugin-ui",
    "prepublishOnly": "npm run lint && npm run build && npm run plugin-ui && npm run docs && npm run docs:lint",
    "postpublish": "npm run clean && npm ci",
    "clean": "shx rm -rf ./dist",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test-coverage": "npm run test -- --coverage",
    "docs": "typedoc",
    "docs:lint": "typedoc --emit none --treatWarningsAsErrors"
  },
  "dependencies": {
    "@homebridge/plugin-ui-utils": "^2.2.4",
    "cacheable-lookup": "^7.0.0",
    "croner": "^10.0.1",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "@types/debug": "^4.1.13",
    "@types/node": "^25.9.1",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^10.4.1",
    "eslint-plugin-format": "^2.0.1",
    "homebridge": "^2.0.0-beta.111",
    "homebridge-config-ui-x": "^5.24.0",
    "nodemon": "^3.1.14",
    "shx": "^0.4.0",
    "typedoc": "^0.28.19",
    "vitest": "^4.1.8"
  }
}
