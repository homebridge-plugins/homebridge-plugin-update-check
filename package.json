{
  "name": "@homebridge-plugins/homebridge-updater",
  "displayName": "Homebridge Updater",
  "type": "module",
  "version": "3.1.13",
  "description": "A Homebridge plugin for checking for updates to Homebridge and plugins",
  "author": "David Maher",
  "license": "BSD-2-Clause",
  "funding": [
    {
      "type": "kofi",
      "url": "https://ko-fi.com/sunookitsune"
    },
    {
      "type": "paypal",
      "url": "https://paypal.me/sunoo"
    },
    {
      "type": "github",
      "url": "https://github.com/Sunoo"
    },
    {
      "type": "liberapay",
      "url": "https://liberapay.com/Sunoo"
    }
  ],
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/homebridge-plugins/homebridge-updater#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/homebridge-plugins/homebridge-updater.git"
  },
  "bugs": {
    "url": "https://github.com/homebridge-plugins/homebridge-updater/issues"
  },
  "keywords": [
    "homebridge-plugin",
    "supports-matter",
    "supports-hap",
    "plugin",
    "update",
    "updates",
    "upgrade",
    "upgrades",
    "version",
    "versions"
  ],
  "main": "dist/index.js",
  "engines": {
    "homebridge": "^1.11.4 || ^2.0.0",
    "node": "^22.12.0 || ^24.0.0 || ^26.0.0"
  },
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "npm run lint -- --fix",
    "watch": "npm run build && npm link && nodemon",
    "plugin-ui": "rsync ./src/homebridge-ui/public/index.html ./dist/homebridge-ui/public/",
    "build": "rimraf ./dist && tsc && npm run plugin-ui",
    "prepublishOnly": "npm run lint && npm run build",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test-coverage": "npm run test -- --coverage",
    "docs": "typedoc",
    "docs:lint": "typedoc --emit none --treatWarningsAsErrors",
    "changelog:sync": "node .github/scripts/sync-changelog.mjs"
  },
  "dependencies": {
    "@homebridge/plugin-ui-utils": "^2.2.5",
    "cacheable-lookup": "^7.0.0",
    "croner": "^10.0.1",
    "jsonwebtoken": "^9.0.3",
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.3.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.2.0",
    "@types/semver": "^7.8.0",
    "@vitest/coverage-v8": "^4.1.10",
    "homebridge": "^2.4.0",
    "nodemon": "^3.1.14",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  }
}
